# Database Settings (AWS RDS MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=auth_db
DB_USERNAME=root
DB_PASSWORD=your_db_secret_password

# JWT Settings (최소 32바이트 이상의 난수 키 권장)
JWT_SECRET=your_super_secret_jwt_signature_key_for_auth_service
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000

# Kakao OAuth Settings
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:8081/login/oauth2/code/kakao

# MSA Internal Auth Header Secret (서비스 간 통신 보안 암호)
INTERNAL_SECRET_KEY=your_msa_shared_internal_secret_key

# AWS Cloud Settings (프로필 이미지 S3 Pre-signed URL 발급용)
AWS_ACCESS_KEY=your_aws_iam_user_access_key
AWS_SECRET_KEY=your_aws_iam_user_secret_key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your_s3_bucket_name_for_profile_images